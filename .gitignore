# ---------------------------------------------------------------------------
# Godot 4.x
# ---------------------------------------------------------------------------
# Editor/import cache. Regenerated by Godot or `godot --headless --import`.
.godot/

# Legacy Godot 3 import directory (harmless if it ever appears)
.import/

# Blender backup / autosave files
*.blend1
*.blend2

# Generated Android build project
/android/

# Exported builds and packages. Never commit shipping artifacts.
/build/
/dist/
/export/
*.pck
*.apk
*.aab

# Export presets can contain signing passwords and keystore paths.
# Keep them local; share a secret-free template instead if the team needs one.
export_presets.cfg
export.cfg

# Generated translation resources (created from CSV files)
*.translation

# ---------------------------------------------------------------------------
# C# / .NET (only used by projects with C# scripts)
# ---------------------------------------------------------------------------
.mono/
data_*/
bin/
obj/
*.csproj.user
*.sln.DotSettings.user
mono_crash.*.json

# ---------------------------------------------------------------------------
# IDE / editor
# ---------------------------------------------------------------------------
.vscode/
.idea/
.vs/
*.suo
*.user
*.swp
*~

# ---------------------------------------------------------------------------
# OS noise
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Logs, dumps, temporary files
# ---------------------------------------------------------------------------
*.log
*.dmp
*.tmp

# Per-machine project setting overrides
override.cfg
