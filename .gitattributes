# ---------------------------------------------------------------------------
# Text / line endings
# ---------------------------------------------------------------------------
# Normalize text to LF in the repository and in working trees. This keeps
# Windows, macOS, and Linux teammates from committing line-ending noise.
* text=auto eol=lf

# Godot text resources and code: reviewable diffs, never LFS.
*.gd              text eol=lf
*.gdshader        text eol=lf
*.gdshaderinc     text eol=lf
*.tscn            text eol=lf
*.tres            text eol=lf
*.godot           text eol=lf
*.cfg             text eol=lf
*.import          text eol=lf
*.uid             text eol=lf
*.json            text eol=lf
*.md              text eol=lf
*.yml             text eol=lf
*.yaml            text eol=lf
*.toml            text eol=lf
*.svg             text eol=lf
*.gltf            text eol=lf
*.cs              text eol=lf
*.csproj          text eol=lf
*.sln             text eol=lf
*.props           text eol=lf
*.targets         text eol=lf

# Windows-only scripts keep CRLF.
*.bat             text eol=crlf
*.cmd             text eol=crlf

